<mujoco model="turtlebot_waffle_pi">

    <compiler angle="radian" autolimits="true"/>
    <option gravity="0 0 -9.81" timestep="0.002"/>

    <default>
        <joint damping="0.5" frictionloss="0.1"/>
        <geom friction="1 0.5 0.5" condim="3"/>
    </default>

    <asset>
        <texture name="floor_tex"
                 type="2d"
                 builtin="checker"
                 rgb1="0.15 0.15 0.15"
                 rgb2="0.25 0.25 0.25"
                 width="512"
                 height="512"/>

        <material name="floor_mat"
                  texture="floor_tex"
                  texrepeat="10 10"
                  reflectance="0"/>

        <material name="robot_mat"
                  rgba="0.15 0.15 0.15 1"/>

        <material name="wheel_mat"
                  rgba="0.03 0.03 0.03 1"/>

        <material name="sensor_mat"
                  rgba="0.1 0.4 0.8 1"/>
    </asset>

    <worldbody>

        <!-- Ground -->
        <geom name="floor"
              type="plane"
              size="10 10 0.1"
              material="floor_mat"/>

        <!-- Lighting -->
        <light name="main_light"
               pos="0 0 5"
               dir="0 0 -1"
               directional="true"/>

        <!-- ========================= -->
        <!-- TurtleBot Main Body        -->
        <!-- ========================= -->

        <body name="base"
              pos="0 0 0.18">

            <freejoint name="base_free"/>

            <!-- Main chassis -->
            <geom name="base_link"
                  type="cylinder"
                  size="0.22 0.10"
                  material="robot_mat"
                  mass="5"/>

            <!-- Top plate -->
            <geom name="top_plate"
                  type="cylinder"
                  pos="0 0 0.13"
                  size="0.19 0.035"
                  material="robot_mat"
                  mass="1"/>

            <!-- ========================= -->
            <!-- Left Wheel                 -->
            <!-- ========================= -->

            <body name="left_wheel"
                  pos="0 0.22 -0.10">

                <joint name="left_wheel_joint"
                       type="hinge"
                       axis="0 1 0"/>

                <geom name="left_wheel_geom"
                      type="cylinder"
                      size="0.065 0.025"
                      euler="90 0 0"
                      material="wheel_mat"
                      mass="0.2"/>

            </body>

            <!-- ========================= -->
            <!-- Right Wheel                -->
            <!-- ========================= -->

            <body name="right_wheel"
                  pos="0 -0.22 -0.10">

                <joint name="right_wheel_joint"
                       type="hinge"
                       axis="0 1 0"/>

                <geom name="right_wheel_geom"
                      type="cylinder"
                      size="0.065 0.025"
                      euler="90 0 0"
                      material="wheel_mat"
                      mass="0.2"/>

            </body>

            <!-- ========================= -->
            <!-- Front Caster               -->
            <!-- ========================= -->

            <body name="front_caster"
                  pos="0.16 0 -0.105">

                <geom name="caster"
                      type="sphere"
                      size="0.045"
                      material="wheel_mat"
                      mass="0.1"/>

            </body>

            <!-- ========================= -->
            <!-- Camera / Sensor            -->
            <!-- ========================= -->

            <body name="camera"
                  pos="0.18 0 0.18">

                <geom name="camera_body"
                      type="box"
                      size="0.04 0.05 0.04"
                      material="sensor_mat"
                      mass="0.05"/>

                <camera name="front_camera"
                        pos="0.06 0 0"
                        euler="0 0 0"
                        fovy="60"/>

            </body>

        </body>

    </worldbody>

    <!-- ========================= -->
    <!-- Wheel Motors               -->
    <!-- ========================= -->

    <actuator>

        <velocity name="left_motor"
                  joint="left_wheel_joint"
                  kv="20"
                  ctrlrange="-15 15"/>

        <velocity name="right_motor"
                  joint="right_wheel_joint"
                  kv="20"
                  ctrlrange="-15 15"/>

    </actuator>

</mujoco>
